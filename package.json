{
  "name": "@local/opencode-usage-ring",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Circular gauge in the DeepSeek Harness sidebar footer: opencode Go plan left for the 5-hour, weekly and monthly limits.",
  "license": "MIT",
  "author": "lancelotmolatelo-cpu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lancelotmolatelo-cpu/deepseek-harness-plugin-opencode-usage-ring.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
